#!/usr/bin/env python3
"""glab-lean: token-lean GitLab views for agents. Wraps `glab api` for auth and host.

Every command prints a short, fixed-shape summary. glab-lean caches full job logs on disk, so
follow-up searches can use grep instead of another API call.
"""
import argparse
import collections
import concurrent.futures as cf
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.parse

CACHE = os.path.expanduser(os.environ.get("GLAB_LEAN_CACHE", "~/.cache/glab-lean"))
DONE_JOB = {"success", "failed", "canceled", "skipped", "manual"}
DONE_PIPE = {"success", "failed", "canceled", "skipped", "manual", "blocked"}
# Settled without failing. A manual pipeline waits for someone to start a job; "blocked" is the
# UI's name for the same state, kept here in case an API ever reports it.
OK_STATES = {"success", "manual", "blocked"}
REPO = None
MAX_PAGES = 50
# Only relative REST paths on the host glab resolves. An absolute URL would make glab send the
# token to another host, so glab-lean refuses it before glab sees it.
SAFE_PATH = re.compile(r"^(projects|merge_requests|groups|users?|version|issues|todos|runners|namespaces)(/|\?|$)")
REPO_RX = re.compile(r"^[\w.-]+(/[\w.-]+)+$")
# glab fills these from the repo it resolves; with -R they would point at the cwd's repo instead.
PLACEHOLDERS = re.compile(r":(id|fullpath|group|namespace|repo|branch)\b")
CACHE_DAYS = 14
CACHE_FILE = re.compile(r"^\d+(\.partial)?\.log$|^\d+\..*\.tmp$")  # the only files prune_cache deletes
NO_PIPE_GRACE = 120  # seconds `wait mr` waits for the MR's pipeline to catch up before giving up


# ---------------------------------------------------------------- API helpers

class ApiError(Exception):
    pass


def check_path(path):
    if "://" in path or "#" in path or not SAFE_PATH.match(path) or \
            re.search(r"(^|/)\.\.(/|$)", path.split("?")[0]):
        raise ApiError(f"refusing path {path!r}: pass a relative REST path such as projects/:id/pipelines")


def run_glab(cmd, inp):
    try:
        return subprocess.run(cmd, input=inp, capture_output=True)
    except FileNotFoundError:
        sys.exit("glab-lean: glab not found; install it and run `glab auth login`")


def glab(path, method="GET", body=None, raw=False, paginate=False):
    check_path(path)
    if REPO:
        # Name the project in the path rather than passing glab -R, which also accepts a host
        # prefix. glab then uses the host it resolves from the cwd or its default.
        path = re.sub(r"^projects/:id(?=/|\?|$)", "projects/" + enc(REPO), path)
        if PLACEHOLDERS.search(path):
            raise ApiError(f"with -R, write the project into {path!r} instead of a placeholder")
    cmd = ["glab", "api"]
    if method != "GET":
        cmd += ["-X", method]
    if paginate:  # page by hand: `--output ndjson` needs a recent glab
        sep = "&" if "?" in path else "?"
        if not re.search(r"[?&]per_page=", path):
            path, sep = f"{path}{sep}per_page=100", "&"
        rows, size = [], min(per_page(path), 100)  # GitLab caps per_page at 100
        for page in range(1, MAX_PAGES + 1):
            chunk = glab(f"{path}{sep}page={page}", method, body, raw)
            if not isinstance(chunk, list):  # single-object endpoint: no pages
                return chunk if page == 1 else rows
            rows.extend(chunk)
            if len(chunk) < size:
                return rows
        print(f"glab-lean: stopped after {MAX_PAGES} pages", file=sys.stderr)
        return rows
    inp = None
    if body is not None:
        cmd += ["-H", "Content-Type: application/json", "--input", "-"]
        inp = json.dumps(body).encode()
    cmd.append(path)
    p = run_glab(cmd, inp)
    if p.returncode != 0 and method == "GET" and not re.search(rb"HTTP 4(?!29)\d\d", p.stderr):
        time.sleep(1)  # one retry: parallel glab calls fail now and then; a 4xx won't fix itself
        p = run_glab(cmd, inp)
    if p.returncode != 0:
        msg = (p.stderr or p.stdout).decode(errors="replace").strip().splitlines()
        raise ApiError(f"{method} {path}: {msg[-1] if msg else 'failed'}")
    out = p.stdout.decode(errors="replace")
    if raw:
        return out
    try:
        return json.loads(out) if out.strip() else None
    except ValueError:  # a login page or proxy error instead of the API
        raise ApiError(f"{method} {path}: response isn't JSON: {cut(out, 80)}") from None


def per_page(path):
    m = re.search(r"[?&]per_page=(\d+)", path)
    return int(m.group(1)) if m else 20


def q(**kw):
    return urllib.parse.urlencode({k: v for k, v in kw.items() if v is not None}, doseq=True)


def enc(s):
    return urllib.parse.quote(str(s), safe="")


def parallel(*fns, need=0):
    """Run fns at once. A failed call returns None, except that the first `need` calls re-raise."""
    with cf.ThreadPoolExecutor(len(fns)) as ex:
        futs = [ex.submit(f) for f in fns]
    out = []
    for n, f in enumerate(futs):
        try:
            out.append(f.result())
        except ApiError:
            if n < need:
                raise
            out.append(None)
    return out


def branch():
    p = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit("glab-lean: not in a git repo, so there's no current branch; pass an ID" +
                 ("" if REPO else " (and -R group/project outside the repo)"))
    return p.stdout.strip()


def git(*args):
    """Output of a git command, or None outside a repo or on error."""
    p = subprocess.run(["git", *args], capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else None


def dur(s):
    if s is None:
        return "-"
    s = int(s)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def cut(s, n):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[: n - 1] + "…"


def dig(d, key):
    for k in key.split("."):
        d = d.get(k) if isinstance(d, dict) else None
    return d


def regex(s, flags=0):
    try:
        return re.compile(s, flags)
    except re.error as e:
        sys.exit(f"glab-lean: bad regex {s!r}: {e}")


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if home != "/" and path.startswith(home + os.sep) else path


def merged_sha(m):
    return (m.get("squash_commit_sha") or m.get("merge_commit_sha") or "")[:8]


# ---------------------------------------------------------------- resolution

def branch_mrs(b):
    """Open MRs from branch b of this project. A fork's MR can share the branch name; skip it."""
    mrs = glab(f"projects/:id/merge_requests?{q(source_branch=b, state='opened')}") or []
    return [m for m in mrs if m.get("source_project_id", m.get("project_id")) == m.get("project_id")]


def resolve_mr(iid):
    if iid:
        return int(str(iid).lstrip("!"))
    b = branch()
    mrs = branch_mrs(b)
    if not mrs:
        sys.exit(f"glab-lean: no open MR for branch {b}")
    return mrs[0]["iid"]


def mr_pipeline(m):
    """(pipeline ID, project) for an MR's head pipeline. A fork MR's pipeline can live in the fork."""
    hp = m["head_pipeline"]
    return hp["id"], str(hp.get("project_id") or ":id")


def resolve_pipe(pid=None, mr=None, ref=None):
    """Return (pipeline ID, project), where project is ":id" or a numeric project ID."""
    if pid:
        return int(pid), ":id"
    if mr is not None:
        m = glab(f"projects/:id/merge_requests/{resolve_mr(mr)}")
        if not m.get("head_pipeline"):
            sys.exit(f"glab-lean: !{m['iid']} has no pipeline yet")
        return mr_pipeline(m)
    if ref:
        ps = glab(f"projects/:id/pipelines?{q(ref=ref, per_page=1)}")
        if not ps:
            sys.exit(f"glab-lean: no pipelines for ref {ref}")
        return ps[0]["id"], ":id"
    # The open MR's head pipeline is the one that gates the merge; the branch's newest pipeline
    # may be a branch pipeline that runs beside it, so it's only the fallback.
    b = branch()
    mrs, ps = parallel(lambda: branch_mrs(b),
                       lambda: glab(f"projects/:id/pipelines?{q(ref=b, per_page=1)}"), need=2)
    if mrs:
        m = glab(f"projects/:id/merge_requests/{mrs[0]['iid']}")
        if m.get("head_pipeline"):
            return mr_pipeline(m)
    if ps:
        return ps[0]["id"], ":id"
    sys.exit(f"glab-lean: no pipelines for branch {b}")


# ---------------------------------------------------------------- job logs

TS = re.compile(r"^\d{4}-\d\d-\d\dT[\d:.]+Z [0-9a-f]{2}[OE](\+| )?")
SECTION = re.compile(r"section_(start|end):\d+:([^\r\s\[]+)(\[[^\]]*\])?\r?(\x1b\[0K)?")
# Every escape form a terminal acts on: CSI, OSC (BEL or ST ended), DCS/SOS/PM/APC, 2-byte ESC,
# and 8-bit CSI. Then any remaining C0/C1 control and every invisible formatting character: soft
# hyphen, bidi marks and overrides, zero-width and word-joiner characters, BOM, variation
# selectors, and Unicode tags, which can spell out hidden text.
ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?|"
                  r"\x1b[PX^_][^\x1b]*(?:\x1b\\)?|\x1b[ -/]*[0-~]|\x9b[0-?]*[ -/]*[@-~]")
CTRL = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u00ad\u061c\u180e\u200b-\u200f\u2028-\u202e"
                  "\u2060-\u2064\u2066-\u2069\ufe00-\ufe0f\ufeff\U000e0000-\U000e007f\U000e0100-\U000e01ef]")
# clean_log writes each section start as "== name". GitLab section names have no spaces, which
# keeps them apart from script output such as "== 2026... CreateUsers: migrating".
MARK = re.compile(r"^== (\S+)$")
# Sections the runner itself opens. A runner section runs until the next one, so a section the
# script opens inside step_script doesn't end it.
RUNNER_SECTION = re.compile(r"^(prepare_executor|prepare_script|resolve_secrets|get_sources|clear_worktree|"
                            r"restore_cache|download_artifacts|step_\w+|build_script|after_script|"
                            r"archive_cache(_on_failure)?|upload_artifacts_on_(success|failure)|"
                            r"cleanup_file_variables)$")
TRAILER = re.compile(r"^(archive_cache(_on_failure)?|upload_artifacts_on_(success|failure)|cleanup_file_variables)$")
TRAILER_NOISE = re.compile(r"^ERROR: (Job failed|No files to upload)|no matching files")


def sanitize(text):
    """Strip terminal control sequences from untrusted GitLab text before it's printed."""
    return CTRL.sub("", ANSI.sub("", text))


class SafeOut:
    """stdout/stderr wrapper: everything printed passes through sanitize()."""

    def __init__(self, stream):
        self.stream = stream

    def write(self, text):
        return self.stream.write(sanitize(text))

    def __getattr__(self, name):
        return getattr(self.stream, name)


def section_start(mm):
    return f"\n== {mm.group(2)}\n" if mm.group(1) == "start" else ""


def clean_log(raw):
    out = []
    for line in raw.split("\n"):
        m = TS.match(line)
        cont = bool(m and m.group(1) == "+")
        if m:
            line = line[m.end():]
        line = ANSI.sub("", SECTION.sub(section_start, line))
        parts = []
        for seg in line.split("\n"):
            if "\r" in seg:
                segs = [x for x in seg.split("\r") if x.strip()]
                seg = segs[-1] if segs else ""
            parts.append(CTRL.sub("", seg).rstrip())  # NULs would make grep treat the cache as binary
        if cont and out:
            out[-1] += parts[0]
            parts = parts[1:]
        out.extend(parts)
    return [l for i, l in enumerate(out) if l or (i and out[i - 1])]


def job_meta(jid):
    return glab(f"projects/:id/jobs/{jid}")


def job_log(job):
    """Return (lines, cache path). Finished jobs are read from and written to the cache. The path
    is None when the cache can't be written; the log is still returned."""
    m = re.match(r"https?://([^/]+)/(.+?)/-/jobs/", job["web_url"])
    slug = (m.group(1) + "/" + m.group(2)).replace("/", "_") if m else "unknown"
    path = os.path.join(CACHE, slug, f"{int(job['id'])}.log")
    done = job["status"] in DONE_JOB - {"manual"}
    if done and os.path.exists(path):
        try:
            os.utime(path)  # recently read logs survive prune_cache()
        except OSError:
            pass
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().split("\n"), path
    proj = (job.get("pipeline") or {}).get("project_id") or ":id"  # a fork MR's job lives in the fork
    lines = clean_log(glab(f"projects/{proj}/jobs/{job['id']}/trace", raw=True))
    if not done:  # a partial trace must never be served later as the final log
        path = path[:-4] + ".partial.log"
    try:
        return lines, save_log(path, lines, keep=done and any(lines))
    except OSError:
        return lines, None


def save_log(path, lines, keep):
    # Logs can hold secrets a job printed: keep the cache private to the user.
    folder = os.path.dirname(path)
    if not os.path.isdir(CACHE):
        os.makedirs(CACHE, mode=0o700)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    if os.stat(folder).st_uid == os.getuid():
        os.chmod(folder, 0o700)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=os.path.basename(path)[:-4] + ".", suffix=".tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    if not keep and not path.endswith(".partial.log"):  # an empty final log: don't serve it later
        path = path[:-4] + ".partial.log"
    os.replace(tmp, path)
    if keep:
        try:
            os.unlink(path[:-4] + ".partial.log")
        except FileNotFoundError:
            pass
    prune_cache()
    return path


def prune_cache():
    """Once a day, delete cached logs nobody has read for CACHE_DAYS. Only glab-lean's own files
    (<slug>/<job id>.log and its temp files) are touched, in case GLAB_LEAN_CACHE is shared."""
    stamp = os.path.join(CACHE, ".glab-lean-pruned")
    now = time.time()
    try:
        if os.path.exists(stamp) and os.stat(stamp).st_mtime > now - 86400:
            return
        open(stamp, "a").close()
        os.utime(stamp)
        folders = [os.path.join(CACHE, d) for d in os.listdir(CACHE)]
    except OSError:
        return
    for folder in folders:
        try:
            names = os.listdir(folder) if os.path.isdir(folder) else []
        except OSError:
            continue
        for name in names:
            f = os.path.join(folder, name)
            try:
                if CACHE_FILE.match(name) and os.stat(f).st_mtime < now - CACHE_DAYS * 86400:
                    os.unlink(f)
            except OSError:
                pass


ERR = re.compile(r"(?i)(\berror\b|\bfatal\b|exception|traceback|\bfail(ed|ure)?\b|exit code [1-9]|"
                 r"exit status [1-9]|permission denied|not found|timed? ?out|\bpanic\b)")
# Lines that match ERR but report success: zero-failure summaries, flags, and config.
NOISE = re.compile(r"(?i)((?<![\w.])0 (fail(ed|ures?)?|errors?)\b|\b(fail(ed|ures?)?|errors?)\s*[=:]?\s*0\b(?![.\d])"
                   r"|--fail|allow_failure|set -e)|(?-i:\bERROR_[A-Z])")


def job_header(j):
    reason = f"  reason {j['failure_reason']}" if j.get("failure_reason") else ""
    af = " (allowed to fail)" if j.get("allow_failure") and j["status"] == "failed" else ""
    return (f"job {j['id']} {j['name']} [{j['stage']}] {j['status']}{af}  {dur(j.get('duration'))}"
            f"  pipeline {j['pipeline']['id']}  ref {j['ref']}{reason}")


def log_note(path, lines):
    if path is None:
        return f"log: not cached (can't write {tilde(CACHE)}); {len(lines)} lines"
    return f"log: {path} ({len(lines)} lines; grep it directly for more)"


NO_LOG = ("created", "pending", "manual", "skipped", "scheduled", "waiting_for_resource", "preparing",
          "waiting_for_callback")


def cmd_job(a):
    j = job_meta(a.id)
    print(job_header(j))
    if j["status"] in NO_LOG:
        return
    lines, path = job_log(j)
    print(log_note(path, lines))
    marks = sections(lines)
    if a.sections:
        for name, lo, hi in marks:
            print(f"  {name}  lines {lo + 1}-{hi} ({hi - lo})")
        return
    if a.section:
        for name, lo, hi in marks:
            if a.section in name:
                print("\n".join(lines[lo + 1:hi]))
        return
    if a.full:
        print("\n".join(lines))
        return
    if a.grep:
        rx = regex(a.grep)
        show_hits(lines, [i for i, l in enumerate(lines) if rx.search(l)], a.context, a.max)
        return
    if a.tail is not None or a.head is not None:
        print("\n".join(lines[: a.head] if a.head is not None else lines[len(lines) - a.tail:]))
        return
    # Default: error lines, then the tail.
    tail_n = 25 if j["status"] == "failed" else 8
    end = body_end(lines)
    tail_from = max(0, end - tail_n)
    if j["status"] == "failed":
        hits = [i for i in error_lines(lines, end) if i < tail_from]
        if hits:
            print(f"-- error-like lines ({len(hits)}) --")
            show_hits(lines, hits, 0, a.max)
    print("-- tail --")
    print("\n".join(l for l in lines[tail_from:end] if l))


def show_hits(lines, hits, ctx, mx):
    if len(hits) > mx:
        print(f"({len(hits)} matches, showing last {mx}; raise --max or grep the log file)")
        hits = hits[len(hits) - mx:]
    last = -1
    for i in hits:
        lo, hi = max(0, i - ctx), min(len(lines), i + ctx + 1)
        if ctx and last >= 0 and lo > last + 1:
            print("--")
        for k in range(max(lo, last + 1), hi):
            print(f"{k + 1}: {cut(lines[k], 400)}")
        last = hi - 1


def sections(lines):
    """(name, marker index, end index) for each section. A runner section ends at the next runner
    section; a section the script opened ends at the next section of any kind."""
    marks = [(i, MARK.match(l).group(1)) for i, l in enumerate(lines) if MARK.match(l)]
    out = []
    for n, (i, name) in enumerate(marks):
        later = marks[n + 1:]
        if RUNNER_SECTION.match(name):
            later = [m for m in later if RUNNER_SECTION.match(m[1])]
        out.append((name, i, later[0][0] if later else len(lines)))
    return out


def body_end(lines):
    """Index where the runner's trailing sections (artifacts, cache, cleanup) start. They're kept
    when they hold a real error, such as an artifact upload that failed the job."""
    end = len(lines)
    for name, i, _ in reversed(sections(lines)):
        if not TRAILER.match(name):
            break
        end = i
    if any(l.startswith("ERROR: ") and not TRAILER_NOISE.search(l) for l in lines[end:]):
        return len(lines)
    return end


def error_lines(lines, end, start=0):
    return [i for i in range(start, end) if ERR.search(lines[i]) and not NOISE.search(lines[i])
            and not lines[i].startswith("$ ")]


RUNNER = re.compile(r"(Executing \"step_script\"|Using (effective pull policy|docker image|Docker executor)|"
                    r"Pulling docker image|Running on |Running after_script|Preparing (the|environment)|"
                    r"Skipping Git|Fetching changes|Checking out |Created fresh repository|Getting source from|"
                    r"Resolving secrets|Waiting for pod)")


def error_excerpt(job, n=10):
    """Why a job failed, in a few lines: its first and last error-like lines plus the distinct
    messages at the end of its script. Lines that differ only in their first word (one per locale,
    host, file, …) appear once with a count. Returns (lines, cached log path or None)."""
    try:
        lines, path = job_log(job)
    except (ApiError, OSError):
        return [], None
    end = body_end(lines)
    marks = sections(lines)
    script = next(((lo + 1, hi) for name, lo, hi in marks if name == "step_script"), None)
    start, stop = script or (0, end)  # the script's own output, without setup and after_script
    stop = min(stop, end)

    def shape(line):
        return " ".join(line.split()[1:]) or line

    body = [i for i in range(start, stop) if re.search(r"\w", lines[i]) and not MARK.match(lines[i])
            and not lines[i].startswith("$ ") and not RUNNER.match(lines[i])]
    counts = collections.Counter(shape(lines[i]) for i in body)
    latest = {shape(lines[i]): i for i in body[-40:]}  # last line of each shape
    tail = sorted(latest.values())[-8:]
    shapes = {shape(lines[i]) for i in tail}
    found = [i for i in error_lines(lines, stop, start) if shape(lines[i]) not in shapes]
    errs = sorted(set(found[:1] + found[-4:]))  # the first error is often the cause
    pick = sorted(errs + tail)
    if len(pick) > n:
        first = errs[:1]
        pick = first + [i for i in pick if i not in first][len(pick) - n:]
    out = []
    for i in pick:
        c = counts[shape(lines[i])] if i in tail else 1
        out.append(cut(lines[i], 200) + (f"  (×{c})" if c > 1 else ""))
    return out, tilde(path) if path else None


# ---------------------------------------------------------------- pipelines

ORDER = {"failed": 0, "running": 1, "canceling": 2, "pending": 3, "preparing": 4, "waiting_for_resource": 5,
         "waiting_for_callback": 6, "scheduled": 7, "manual": 8, "canceled": 9, "created": 10}


def pipe_summary(pid, show_all=False, errors=True, proj=":id"):
    base_url = f"projects/{proj}/pipelines/{pid}"
    p, jobs, bridges = parallel(
        lambda: glab(base_url),
        lambda: glab(f"{base_url}/jobs?per_page=100", paginate=True),
        lambda: glab(f"{base_url}/bridges?per_page=100", paginate=True),
        need=1,
    )
    if jobs is None:
        print("glab-lean: jobs unavailable (API error); rerun to see them", file=sys.stderr)
    if bridges is None:
        print("glab-lean: child pipelines unavailable (API error); rerun to see them", file=sys.stderr)
    jobs, bridges = jobs or [], bridges or []
    print(f"pipeline {p['id']} {p['status']}  ref {p['ref']}  sha {p['sha'][:8]}  {dur(p.get('duration'))}"
          f"  source {p.get('source')}\n{p['web_url']}")
    counts = collections.Counter(j["status"] for j in jobs)
    print("jobs: " + (", ".join(f"{v} {k}" for k, v in counts.most_common()) or "none"))
    rows = jobs if show_all else [j for j in jobs if j["status"] in ORDER]
    groups = {}
    for j in sorted(rows, key=lambda j: (ORDER.get(j["status"], 99), j["stage"], j["name"])):
        base = re.sub(r"[:\s]*\[[^\]]*\]$", "", j["name"]) if not show_all else j["id"]
        allowed = bool(j.get("allow_failure")) and j["status"] == "failed"
        groups.setdefault((j["status"], j["stage"], base, allowed), []).append(j)
    # Answer "which failed, and why" in one call: error lines for up to 3 blocking failures,
    # spread across groups so a failing matrix doesn't use up all three.
    blocking = [js for (status, _, _, allowed), js in groups.items() if status == "failed" and not allowed]
    failed = [js[k] for k in range(3) for js in blocking if k < len(js)][:3]
    excerpts = {}
    if failed and errors:
        with cf.ThreadPoolExecutor(len(failed)) as ex:
            excerpts = dict(zip((j["id"] for j in failed), ex.map(error_excerpt, failed)))

    def show_excerpt(j, indent):
        lines, path = excerpts.get(j["id"], ([], None))
        for l in lines:
            print(f"{indent}| {l}")
        if path:
            print(f"{indent}log: {path}")

    for (status, stage, base, allowed), js in groups.items():
        extra = " (allowed)" if allowed else ""
        if len(js) > 3:  # parallel:matrix fan-out: one line per group
            ids = sorted(j["id"] for j in js)
            reasons = ",".join(sorted({j["failure_reason"] for j in js if j.get("failure_reason")}))
            reason = f"  {reasons}" if reasons and status == "failed" else ""
            print(f"  {ids[0]}..{ids[-1]}  {stage}/{base} ×{len(js)}  {status}{extra}{reason}  (--all for each)")
            for j in js:
                if j["id"] in excerpts:
                    print(f"    {j['id']}  {j['name']}")
                    show_excerpt(j, "      ")
            continue
        for j in js:
            reason = f"  {j['failure_reason']}" if j.get("failure_reason") and status == "failed" else ""
            print(f"  {j['id']}  {stage}/{j['name']}  {status}{extra}{reason}")
            show_excerpt(j, "      ")
    for b in bridges:
        d = b.get("downstream_pipeline") or {}
        print(f"  child {d.get('id', '-')} via {b['name']}  {d.get('status', b['status'])}")
    return p


def cmd_pipe(a):
    pid, proj = resolve_pipe(a.id, a.mr, a.ref)
    pipe_summary(pid, a.all, not a.brief, proj)


def cmd_pipes(a):
    ps = glab(f"projects/:id/pipelines?{q(ref=a.ref, status=a.status, per_page=a.limit)}")
    for p in ps:
        print(f"{p['id']}  {p['status']:9} {p.get('source') or '-':22} {(p.get('created_at') or '')[:16]}  {p['ref']}")


# ---------------------------------------------------------------- waiting

JOB_DEFAULTS = dict(sections=False, section=None, full=False, grep=None, tail=None, head=None, max=30, context=0)


def cmd_wait(a):
    until = set(a.until.split(",")) if a.until else set()
    started = time.time()
    if a.kind == "mr":
        iid = resolve_mr(a.id)
        # On the MR's own branch, the local HEAD tells us which commit should be under test, so a
        # pipeline from before a push isn't taken as the answer.
        local = None if REPO else git("rev-parse", "HEAD")
        here = None if REPO else git("rev-parse", "--abbrev-ref", "HEAD")

        def poll():
            m = glab(f"projects/:id/merge_requests/{iid}")
            if until:
                hit = bool(until & {m["state"], m.get("detailed_merge_status"), m.get("merge_status")})
                return m["state"], hit or m["state"] in ("merged", "closed"), hit, m
            if m["state"] in ("merged", "closed"):
                return m["state"], True, m["state"] == "merged", m
            late = time.time() >= started + NO_PIPE_GRACE  # GitLab had time to catch up
            if local and m.get("source_branch") == here and m["sha"] != local:
                upstream = git("rev-parse", "@{u}")
                if upstream and upstream != local:
                    return "not-pushed", True, False, m
                return "mr-not-updated", late, False, m  # pushed; GitLab hasn't refreshed the MR yet
            hp = m.get("head_pipeline")
            if not hp:  # a pipeline can take a moment to appear after a push
                return "no-pipeline", late, False, m
            if not on_head(hp, m):
                return "stale-pipeline", late, False, m
            st = hp["status"]
            return st, st in DONE_PIPE, st in OK_STATES, m
    else:
        url = f"projects/:id/{'jobs' if a.kind == 'job' else 'pipelines'}/{int(a.id)}"
        final = DONE_JOB if a.kind == "job" else DONE_PIPE

        def poll():
            o = glab(url)
            st = o["status"]
            hit = st in until if until else st in OK_STATES
            return st, st in until or st in final, hit, o

    deadline, polls, errors = started + a.timeout, 0, 0
    while True:
        polls += 1
        try:
            st, done, ok, obj = poll()
            errors = 0
        except ApiError as e:
            errors += 1
            if polls == 1 or errors >= 5:  # a bad ID or repo won't fix itself
                sys.exit(f"glab-lean: {e}")
            st, done = f"api-error: {e}", False
        if done:
            break
        if time.time() > deadline:
            print(f"timeout after {a.timeout}s; last status: {st}")
            sys.exit(124)
        time.sleep(a.every)
    why = {"no-pipeline": f"no pipeline after {NO_PIPE_GRACE}s",
           "stale-pipeline": f"no pipeline for the head commit after {NO_PIPE_GRACE}s",
           "mr-not-updated": f"the MR still isn't on your pushed commit after {NO_PIPE_GRACE}s",
           "not-pushed": "your local HEAD isn't pushed; push it first"}.get(st)
    try:  # the exit code reports what was waited for, even if the summary can't be fetched
        if a.kind == "job":
            cmd_job(argparse.Namespace(id=int(a.id), **JOB_DEFAULTS))
        elif a.kind == "pipe":
            pipe_summary(int(a.id))
        elif until or why or not (obj.get("head_pipeline") or {}).get("id"):
            note = f"  {why}" if why else ""
            print(f"!{obj['iid']} {obj['state']} merge_status {obj.get('detailed_merge_status')}{note}")
        else:
            pid, proj = mr_pipeline(obj)
            pipe_summary(pid, proj=proj)
    except ApiError as e:
        print(f"glab-lean: summary unavailable: {e}", file=sys.stderr)
    sys.exit(0 if ok else 1)


# ---------------------------------------------------------------- merge requests

def omitted(d):
    """True when GitLab left the patch out because it's too large to return."""
    return bool(d.get("too_large") or (d.get("collapsed") and not d.get("diff")))


def diff_stat(d):
    """(added, removed, label). Counts are None when GitLab omitted the patch."""
    lines = d.get("diff", "").splitlines()
    tag = " (new)" if d.get("new_file") else " (deleted)" if d.get("deleted_file") else \
        f" (from {d['old_path']})" if d.get("renamed_file") else ""
    if omitted(d):
        return None, None, f"{d['new_path']}{tag} (diff too large to show)"
    add = sum(1 for l in lines if l.startswith("+"))
    rem = sum(1 for l in lines if l.startswith("-"))
    return add, rem, f"{d['new_path']}{tag}"


def stat_line(add, rem, name):
    return f"+{'?' if add is None else add} -{'?' if rem is None else rem}  {name}"


def get_diffs(iid):
    try:
        return glab(f"projects/:id/merge_requests/{iid}/diffs?per_page=100", paginate=True)
    except ApiError:
        return glab(f"projects/:id/merge_requests/{iid}/changes")["changes"]


def on_head(hp, m):
    """True when the pipeline ran on the MR's current head commit."""
    if hp.get("sha") == m["sha"]:
        return True
    # Merged-results and merge-train pipelines run on a merge commit whose parent is the head.
    if re.match(r"refs/merge-requests/\d+/(merge|train)$", str(hp.get("ref", ""))):
        try:
            return m["sha"] in glab(f"projects/:id/repository/commits/{hp['sha']}").get("parent_ids", [])
        except ApiError:
            return True  # can't tell; don't claim it's stale
    return False


def unresolved(discs):
    return [d for d in discs if any(n.get("resolvable") and not n.get("resolved") for n in d["notes"])]


def cmd_mr(a):
    iid = resolve_mr(a.iid)
    m, appr, discs, diffs = parallel(
        lambda: glab(f"projects/:id/merge_requests/{iid}"),
        lambda: glab(f"projects/:id/merge_requests/{iid}/approvals"),
        lambda: glab(f"projects/:id/merge_requests/{iid}/discussions?per_page=100", paginate=True),
        lambda: get_diffs(iid),
        need=1,
    )
    draft = " [draft]" if m.get("draft") else ""
    print(f"!{m['iid']}{draft} {m['title']}")
    print(f"{m['state']}  {m['source_branch']} → {m['target_branch']}  by @{m['author']['username']}"
          f"  updated {m['updated_at'][:16]}\n{m['web_url']}")
    blockers = []
    ms = m.get("detailed_merge_status") or m.get("merge_status")
    pending = ms in ("checking", "unchecked", "cannot_be_merged_recheck", "approvals_syncing", "preparing")
    if m["state"] == "opened" and ms not in ("mergeable", "can_be_merged") and not pending:
        blockers.append(ms)
    if m.get("has_conflicts") and "conflict" not in str(ms):
        blockers.append("conflicts")
    if appr:
        left = appr.get("approvals_left", 0)
        by = ",".join("@" + x["user"]["username"] for x in appr.get("approved_by", [])) or "none"
        print(f"approvals: {left} left, approved by {by}")
    elif appr is None:
        print("approvals: unavailable (API error)")
    hp = m.get("head_pipeline")
    if hp:
        stale = "" if on_head(hp, m) else " (not on latest commit)"
        print(f"pipeline {hp['id']} {hp['status']}{stale}")
    else:
        print("pipeline: none")
    if discs is None:
        print("threads: unavailable (API error); rerun to see them")
    else:
        total = sum(1 for d in discs if any(n.get("resolvable") for n in d["notes"]))
        print(f"threads: {len(unresolved(discs))} unresolved of {total}")
    if m["state"] == "opened":
        print("blocked: " + ", ".join(blockers) if blockers else
              f"merge status pending ({ms}); check again shortly" if pending else
              f"{ms} per GitLab, but threads are unavailable; rerun to confirm" if discs is None else
              "ready to merge")
    elif m["state"] == "merged":
        print(f"merged {str(m.get('merged_at'))[:16]}  sha {merged_sha(m)}")
    meta = []
    if m.get("labels"):
        meta.append("labels " + ",".join(m["labels"]))
    if m.get("reviewers"):
        meta.append("reviewers " + ",".join("@" + r["username"] for r in m["reviewers"]))
    if meta:
        print("  ".join(meta))
    if diffs is None:
        print("files: unavailable (API error)")
    else:
        stats = [diff_stat(d) for d in diffs]
        big = sum(1 for s in stats if s[0] is None)
        note = f"; {big} too large to count" if big else ""
        print(f"files ({len(stats)}, +{sum(s[0] or 0 for s in stats)} -{sum(s[1] or 0 for s in stats)}{note}):")
        for st in stats[: a.files]:
            print("  " + stat_line(*st))
        if len(stats) > a.files:
            print(f"  … {len(stats) - a.files} more (glab-lean diff {iid})")
    desc = (m.get("description") or "").strip()
    if desc and a.desc != 0:
        dl = desc.splitlines()
        n = len(dl) if a.desc < 0 else a.desc
        print("description:")
        print("\n".join("  " + cut(l, 200) for l in dl[:n]))
        if len(dl) > n:
            print(f"  … {len(dl) - n} more lines (--desc -1)")


def repo_path(p):
    """A path as GitLab spells it: relative to the repo root, without a leading ./"""
    if os.path.isabs(p):
        top = git("rev-parse", "--show-toplevel")
        if top:
            p = os.path.relpath(p, top)
    return re.sub(r"^(\./)+", "", p)


def cmd_diff(a):
    if a.iid and not re.fullmatch(r"!?\d+", a.iid):  # `diff src/app.py`: the first arg is a path
        a.paths.insert(0, a.iid)
        a.iid = None
    iid = resolve_mr(a.iid)
    diffs = get_diffs(iid)
    if not a.paths:
        for d in diffs:
            print(stat_line(*diff_stat(d)))
        return
    want = [repo_path(p) for p in a.paths]
    shown = 0
    for d in diffs:
        if not any(p in d["new_path"] or p in d["old_path"] for p in want):
            continue
        shown += 1
        print(f"--- {d['old_path']}\n+++ {d['new_path']}")
        if omitted(d):
            print("(GitLab omits this diff because it's too large; view it in the MR)")
            continue
        lines = d.get("diff", "").splitlines()
        print("\n".join(lines[: a.max]))
        if len(lines) > a.max:
            print(f"… {len(lines) - a.max} more lines (--max)")
    if not shown:
        sys.exit(f"glab-lean: !{iid} changes no file matching {', '.join(want)}")


def cmd_threads(a):
    iid = resolve_mr(a.iid)
    discs = glab(f"projects/:id/merge_requests/{iid}/discussions?per_page=100", paginate=True)
    if not (a.all or a.general):  # general comments can't be resolved, so they're never unresolved
        discs = unresolved(discs)
    discs = [d for d in discs if not all(n.get("system") for n in d["notes"])]
    if a.general:
        discs = [d for d in discs if not any(n.get("resolvable") for n in d["notes"])]
    kind = "general comments" if a.general else "threads" if a.all else "unresolved threads"
    print(f"!{iid}: {len(discs)} {kind}")
    for d in discs:
        notes = [n for n in d["notes"] if not n.get("system")]  # e.g. "changed this line in version 3"
        n0 = notes[0]
        pos = n0.get("position") or {}
        loc = f"{pos.get('new_path') or pos.get('old_path')}:{pos.get('new_line') or pos.get('old_line')}" \
            if pos else "general"
        res = " resolved" if all(n.get("resolved") for n in d["notes"] if n.get("resolvable")) and \
            any(n.get("resolvable") for n in d["notes"]) else ""
        print(f"\n[{d['id']}] {loc}  @{n0['author']['username']} {n0['created_at'][:10]}"
              f"  ({len(notes)} notes){res}")
        print("  " + (n0["body"] if a.full else cut(n0["body"], 400)))
        replies = notes[1:] if a.full else notes[-1:] if len(notes) > 1 else []
        for n in replies:
            print(f"  ↳ @{n['author']['username']}: {n['body'] if a.full else cut(n['body'], 250)}")


def cmd_mrs(a):
    p = {"state": a.state, "per_page": a.limit, "order_by": "updated_at"}
    if a.mine:
        p["scope"] = "created_by_me"
    elif a.everywhere:
        p["scope"] = "all"
    if a.review:
        p["reviewer_username"] = a.review
    if a.source:
        p["source_branch"] = a.source
    if a.search:
        p["search"] = a.search
    base = "merge_requests" if a.everywhere else "projects/:id/merge_requests"
    for m in glab(f"{base}?{q(**p)}"):
        draft = "draft " if m.get("draft") else ""
        where = m["references"]["full"] if a.everywhere else f"!{m['iid']}"
        print(f"{where}  {draft}{m['updated_at'][:10]}  @{m['author']['username']}  "
              f"{m['source_branch']}  {cut(m['title'], 90)}")


# ---------------------------------------------------------------- terraform

TF_HDR = re.compile(r"^\s*# (.+?) (will be created|will be destroyed|will be updated in-place|must be replaced|"
                    r"will be replaced.*|is tainted.*|will be read during apply|has moved to .+|"
                    r"will no longer be managed.*|will be removed from the .* state.*|will be imported.*|"
                    r"has changed|has been deleted)"
                    r"(\s*\(.*\))?$")
SYM = {"will be created": "+", "will be destroyed": "-", "will be updated in-place": "~",
       "must be replaced": "-/+", "will be read during apply": "<=", "has changed": "drift~",
       "has been deleted": "drift-"}
TF_END = re.compile(r"^(Plan: |No changes\.|Changes to Outputs:|Apply complete!|Destroy complete!|"
                    r"─{10}|Saved the plan|Warning: |Terraform will perform|OpenTofu will perform)")
TF_TOTAL = re.compile(r"^(Plan: .*|No changes\..*|Apply complete!.*|Destroy complete!.*|Changes to Outputs:|"
                      r"This is a refresh-only plan.*)")
TF_ERR = re.compile(r"^[│|]?\s*Error: ")


def tf_parse(lines):
    res, totals, errs = [], [], []
    for i, l in enumerate(lines):
        m = TF_HDR.match(l)
        if m:
            what = m.group(2)
            sym = SYM.get(what) or ("->" if what.startswith("has moved") else
                                    "-/+" if "replace" in what or "tainted" in what else
                                    "import" if "imported" in what else "forget")
            note = f"  {what}" if sym == "->" else ""
            res.append((i, sym, m.group(1) + note))
        elif TF_TOTAL.match(l):
            totals.append(l.strip())
        elif TF_ERR.match(l):
            block = [l.strip("│ ")]
            for k in range(i + 1, min(i + 8, len(lines))):
                s = lines[k].strip("│ ╵")
                if not s and len(block) > 1:
                    break
                if s:
                    block.append(s)
            errs.append(" | ".join(block))
    return res, totals, errs


def tf_block(lines, start, full):
    out = [lines[start].strip()]
    for l in lines[start + 1:]:
        if TF_HDR.match(l) or TF_END.match(l.strip()):
            break
        s = l.strip()
        if full or (s and s[0] in "+-~") or s.startswith("<=") or "forces replacement" in s:
            out.append(l)
    return out


def tf_jobs(a):
    """The jobs to read: the one given, or the pipeline's finished jobs whose names match --name."""
    if a.job:
        return [job_meta(a.job)]
    pid, proj = resolve_pipe(a.pipe, a.mr)
    jobs = glab(f"projects/{proj}/pipelines/{pid}/jobs?per_page=100", paginate=True)
    rx = regex(a.name, re.I)
    sel = [j for j in jobs if rx.search(j["name"]) and j["status"] in ("success", "failed", "canceled")]
    if not sel:
        names = ", ".join(sorted({f"{j['name']}({j['status']})" for j in jobs}))
        sys.exit(f"glab-lean: no finished jobs matching /{a.name}/ in pipeline {pid}; jobs: {cut(names, 300) or 'none (external or empty pipeline)'}")
    return sel


def cmd_tf(a):
    jobs = tf_jobs(a)
    with cf.ThreadPoolExecutor(min(len(jobs), 4)) as ex:  # fetch the logs at once, print in order
        logs = list(ex.map(job_log, jobs))
    for j, (lines, path) in zip(jobs, logs):
        res, totals, errs = tf_parse(lines)
        print(f"{job_header(j)}\nlog: {path or 'not cached (cache not writable)'}")
        if a.resource:
            hits = [r for r in res if a.resource in r[2]]
            if not hits:
                print(f"  no resource matching {a.resource!r}")
            for i, _, _ in hits:
                print("\n".join(tf_block(lines, i, a.full)))
            continue
        drift = [r for r in res if r[1].startswith("drift")]
        plan = [r for r in res if not r[1].startswith("drift")]
        if drift:
            print(f"drift outside Terraform ({len(drift)}):")
            for _, s, name in drift[: a.max]:
                print(f"  {s[5:]:3} {name}")
        for _, s, name in plan[: a.max]:
            print(f"  {s:3} {name}")
        if len(plan) > a.max:
            print(f"  … {len(plan) - a.max} more (--max)")
        for t in totals:
            print(t)
        for e in errs[:10]:
            print(cut(e, 500))
        if not (res or totals or errs):
            print("  no plan output found; try `glab-lean job` on it")


# ---------------------------------------------------------------- actions

def kv(pairs):
    out = []
    for s in pairs or []:
        k, _, v = s.partition("=")
        out.append({"key": k, "value": v})
    return out


def cmd_run(a):
    body = {"ref": a.ref or branch()}
    if a.var:
        body["variables"] = kv(a.var)
    p = glab("projects/:id/pipeline", "POST", body)
    print(f"pipeline {p['id']} {p['status']}  ref {p['ref']}\n{p['web_url']}")


def cmd_play(a):
    body = {"job_variables_attributes": kv(a.var)} if a.var else None
    j = glab(f"projects/:id/jobs/{a.id}/play", "POST", body)
    print(f"job {j['id']} {j['name']} {j['status']}")


def cmd_retry(a):
    if a.pipe:
        p = glab(f"projects/:id/pipelines/{a.id}/retry", "POST")
        print(f"pipeline {p['id']} {p['status']} (failed jobs retried)")
    else:
        j = glab(f"projects/:id/jobs/{a.id}/retry", "POST")
        print(f"new job {j['id']} {j['name']} {j['status']}")


def cmd_cancel(a):
    kind = "pipelines" if a.pipe else "jobs"
    r = glab(f"projects/:id/{kind}/{a.id}/cancel", "POST")
    print(f"{kind[:-1]} {r['id']} {r['status']}")


def cmd_merge(a):
    iid = resolve_mr(a.iid)
    body = {}
    if a.squash:
        body["squash"] = True
    if a.rm_branch:
        body["should_remove_source_branch"] = True
    if a.auto:
        # auto_merge replaces merge_when_pipeline_succeeds from GitLab 17.11. Older servers ignore
        # auto_merge and would merge at once, so send both.
        body["auto_merge"] = body["merge_when_pipeline_succeeds"] = True
    m = glab(f"projects/:id/merge_requests/{iid}/merge", "PUT", body)
    sha = merged_sha(m)
    auto = "  auto-merge set" if m.get("merge_when_pipeline_succeeds") and m["state"] != "merged" else ""
    print(f"!{iid} {m['state']}{auto}  {sha}")


def body_arg(s):
    return sys.stdin.read() if s == "-" else s


def cmd_note(a):
    iid = resolve_mr(a.iid)
    n = glab(f"projects/:id/merge_requests/{iid}/notes", "POST", {"body": body_arg(a.body)})
    print(f"note {n['id']} on !{iid}")


def cmd_reply(a):
    iid = resolve_mr(a.iid)
    n = glab(f"projects/:id/merge_requests/{iid}/discussions/{a.disc}/notes", "POST", {"body": body_arg(a.body)})
    print(f"reply {n['id']} in {a.disc[:8]} on !{iid}")
    if a.resolve:
        glab(f"projects/:id/merge_requests/{iid}/discussions/{a.disc}?resolved=true", "PUT")
        print("resolved")


def cmd_resolve(a):
    iid = resolve_mr(a.iid)
    val = "false" if a.undo else "true"
    glab(f"projects/:id/merge_requests/{iid}/discussions/{a.disc}?resolved={val}", "PUT")
    print(f"{a.disc[:8]} {'unresolved' if a.undo else 'resolved'}")


# ---------------------------------------------------------------- generic API

def as_text(v):
    """A JSON value as -w compares it: true, false, and null are spelled as in JSON."""
    return "true" if v is True else "false" if v is False else "null" if v is None else str(v)


def matches(v, want):
    return want in (as_text(v), str(v))


def cmd_api(a):
    data = glab(a.path, paginate=a.paginate)
    if not isinstance(data, (dict, list)):
        print(as_text(data))
        return
    rows = data if isinstance(data, list) else [data]
    for w in a.where or []:
        mm = re.match(r"([\w.]+)(!=|=|~)(.*)", w)
        if not mm:
            sys.exit(f"glab-lean: bad --where {w!r}; use key=val, key!=val, or key~regex")
        k, op, v = mm.groups()
        if op == "=":
            rows = [r for r in rows if matches(dig(r, k), v)]
        elif op == "!=":
            rows = [r for r in rows if not matches(dig(r, k), v)]
        else:
            rx = regex(v)
            rows = [r for r in rows if rx.search(as_text(dig(r, k)))]
    if isinstance(data, dict) and not a.fields:
        for k, v in (rows[0].items() if rows else []):
            if not isinstance(v, (dict, list)) and v is not None and v != "" and v is not False:
                print(f"{k}: {cut(as_text(v), 200)}")
            elif isinstance(v, dict) and ("id" in v or "status" in v):
                print(f"{k}: " + " ".join(f"{kk}={v[kk]}" for kk in ("id", "iid", "status", "name") if kk in v))
        return
    if rows and not isinstance(rows[0], dict):  # a list of plain values
        for r in rows[: a.limit]:
            print(cut(as_text(r), 120))
    else:
        fields = a.fields.split(",") if a.fields else \
            [f for f in ("id", "iid", "name", "title", "status", "state", "ref", "stage") if rows and f in rows[0]]
        if rows and not fields:  # none of the usual keys: show the first scalar ones, with a header
            fields = [k for k, v in rows[0].items() if not isinstance(v, (dict, list))][:6]
            print("\t".join(fields))
        for r in rows[: a.limit]:
            print("\t".join(cut(as_text(dig(r, f)), 120) for f in fields))
    if len(rows) > a.limit:
        print(f"… {len(rows) - a.limit} more (--limit)", file=sys.stderr)


# ---------------------------------------------------------------- CLI

def disc_id(s):
    if not re.fullmatch(r"[0-9a-f]{8,64}", s):
        raise argparse.ArgumentTypeError("discussion IDs are hex, as printed by `threads`")
    return s


def mr_iid(s):
    if s == "":  # bare --mr: the current branch's MR
        return s
    if not re.fullmatch(r"!?\d+", s):
        raise argparse.ArgumentTypeError("MR IIDs are numbers, like 42 or !42")
    return s.lstrip("!")


def count(s):
    if not re.fullmatch(r"\d+", s):
        raise argparse.ArgumentTypeError("expected a whole number, 0 or more")
    return int(s)


def main():
    global REPO
    ap = argparse.ArgumentParser(prog="glab-lean", description="Token-lean GitLab views. IDs default to the current branch.")
    ap.add_argument("-R", "--repo", help="group/project (default: current git repo)")
    common = argparse.ArgumentParser(add_help=False)  # accept -R after the subcommand too
    common.add_argument("-R", "--repo", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    sp = ap.add_subparsers(dest="cmd", required=True)
    _add = sp.add_parser
    sp.add_parser = lambda *x, **k: _add(*x, parents=[common], **k)

    p = sp.add_parser("mr", help="MR summary: merge readiness, pipeline, threads, files")
    p.add_argument("iid", nargs="?", type=mr_iid)
    p.add_argument("--desc", type=int, default=8, help="description lines (0 none, -1 all)")
    p.add_argument("--files", type=int, default=15)
    p.set_defaults(fn=cmd_mr)

    p = sp.add_parser("diff", help="MR diffstat, or diffs of files matching PATHS")
    p.add_argument("iid", nargs="?", help="MR IID (or the first path)")
    p.add_argument("paths", nargs="*")
    p.add_argument("--max", type=int, default=300, help="max lines per file")
    p.set_defaults(fn=cmd_diff)

    p = sp.add_parser("threads", help="unresolved MR threads, one block each")
    p.add_argument("iid", nargs="?", type=mr_iid)
    p.add_argument("--all", action="store_true", help="include resolved and general comments")
    p.add_argument("--general", action="store_true", help="only general (non-resolvable) comments")
    p.add_argument("--full", action="store_true", help="untruncated bodies and every reply")
    p.set_defaults(fn=cmd_threads)

    p = sp.add_parser("mrs", help="list MRs")
    p.add_argument("--state", default="opened")
    p.add_argument("--mine", action="store_true")
    p.add_argument("--review", metavar="USER")
    p.add_argument("--source", metavar="BRANCH")
    p.add_argument("--search")
    p.add_argument("--everywhere", action="store_true", help="all projects, not only this one")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(fn=cmd_mrs)

    p = sp.add_parser("pipe", help="pipeline summary: counts plus non-green jobs")
    p.add_argument("id", nargs="?", type=int)
    p.add_argument("--mr", nargs="?", const="", type=mr_iid, help="use the MR's head pipeline")
    p.add_argument("--ref")
    p.add_argument("--all", action="store_true", help="list every job")
    p.add_argument("--brief", action="store_true", help="skip error lines for failed jobs")
    p.set_defaults(fn=cmd_pipe)

    p = sp.add_parser("pipes", help="list recent pipelines")
    p.add_argument("--ref")
    p.add_argument("--status")
    p.add_argument("--limit", type=int, default=10)
    p.set_defaults(fn=cmd_pipes)

    p = sp.add_parser("job", help="job status and log extract; full log cached on disk")
    p.add_argument("id", type=int)
    p.add_argument("--grep", metavar="RE")
    p.add_argument("-C", "--context", type=count, default=0)
    p.add_argument("--tail", type=count)
    p.add_argument("--head", type=count)
    p.add_argument("--sections", action="store_true", help="list log sections")
    p.add_argument("--section", metavar="NAME", help="print one section")
    p.add_argument("--full", action="store_true")
    p.add_argument("--max", type=count, default=30)
    p.set_defaults(fn=cmd_job)

    p = sp.add_parser("wait", help="block silently until a job/pipeline/MR settles, then summarize")
    p.add_argument("kind", choices=["job", "pipe", "mr"])
    p.add_argument("id", nargs="?", type=mr_iid, help="job, pipeline, or MR ID (MR defaults to the branch's)")
    p.add_argument("--until", help="comma-separated states to stop on (MR: merged, mergeable, …)")
    p.add_argument("--every", type=int, default=20, help="poll interval seconds")
    p.add_argument("--timeout", type=int, default=3600)
    p.set_defaults(fn=cmd_wait)

    p = sp.add_parser("tf", help="Terraform/OpenTofu plan summary from job logs")
    p.add_argument("job", nargs="?", type=int)
    p.add_argument("--pipe", type=int)
    p.add_argument("--mr", nargs="?", const="", type=mr_iid)
    p.add_argument("--name", default="plan", help="job-name regex for finished jobs, with --pipe/--mr")
    p.add_argument("-r", "--resource", help="show the change block for resources containing this")
    p.add_argument("--full", action="store_true", help="with -r: include unchanged lines")
    p.add_argument("--max", type=int, default=60)
    p.set_defaults(fn=cmd_tf)

    p = sp.add_parser("run", help="create a pipeline")
    p.add_argument("--ref")
    p.add_argument("-v", "--var", action="append", metavar="K=V")
    p.set_defaults(fn=cmd_run)

    p = sp.add_parser("play", help="start a manual job")
    p.add_argument("id", type=int)
    p.add_argument("-v", "--var", action="append", metavar="K=V")
    p.set_defaults(fn=cmd_play)

    p = sp.add_parser("retry", help="retry a job, or a pipeline's failed jobs with --pipe")
    p.add_argument("id", type=int)
    p.add_argument("--pipe", action="store_true")
    p.set_defaults(fn=cmd_retry)

    p = sp.add_parser("cancel", help="cancel a job, or a pipeline with --pipe")
    p.add_argument("id", type=int)
    p.add_argument("--pipe", action="store_true")
    p.set_defaults(fn=cmd_cancel)

    p = sp.add_parser("merge", help="merge an MR (or set auto-merge)")
    p.add_argument("iid", nargs="?", type=mr_iid)
    p.add_argument("--squash", action="store_true")
    p.add_argument("--rm-branch", action="store_true")
    p.add_argument("--auto", action="store_true", help="merge when the pipeline succeeds")
    p.set_defaults(fn=cmd_merge)

    p = sp.add_parser("note", help="comment on an MR (body '-' reads stdin)")
    p.add_argument("iid", type=mr_iid)
    p.add_argument("body")
    p.set_defaults(fn=cmd_note)

    p = sp.add_parser("reply", help="reply to an MR thread")
    p.add_argument("iid", type=mr_iid)
    p.add_argument("disc", type=disc_id)
    p.add_argument("body")
    p.add_argument("--resolve", action="store_true")
    p.set_defaults(fn=cmd_reply)

    p = sp.add_parser("resolve", help="resolve an MR thread")
    p.add_argument("iid", type=mr_iid)
    p.add_argument("disc", type=disc_id)
    p.add_argument("--undo", action="store_true")
    p.set_defaults(fn=cmd_resolve)

    p = sp.add_parser("api", help="GET any endpoint as TSV/key: value (replaces jq/python glue)")
    p.add_argument("path", help="e.g. 'projects/:id/pipelines?ref=main'")
    p.add_argument("-f", "--fields", help="comma list; dots for nesting (pipeline.id)")
    p.add_argument("-w", "--where", action="append",
                   help="key=val, key!=val, or key~regex; match booleans and null as true, false, null")
    p.add_argument("--paginate", action="store_true")
    p.add_argument("--limit", type=int, default=50)
    p.set_defaults(fn=cmd_api)

    a = ap.parse_args()
    REPO = a.repo
    if REPO and not REPO_RX.match(REPO):
        sys.exit("glab-lean: -R takes group/project, not a URL")
    if a.cmd == "wait" and a.kind != "mr" and a.id is None:
        sys.exit(f"glab-lean: wait {a.kind} needs an ID")
    sys.stdout, sys.stderr = SafeOut(sys.stdout), SafeOut(sys.stderr)
    try:
        a.fn(a)
        sys.stdout.flush()  # inside the try, so a closed pipe here is handled too
    except ApiError as e:
        sys.exit(f"glab-lean: {e}")
    except BrokenPipeError:  # e.g. `| head`: exit quietly
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)


if __name__ == "__main__":
    main()
